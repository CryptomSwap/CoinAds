generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?  // Optional for OAuth users
  role      Role
  name      String?
  createdAt DateTime @default(now())
  campaigns   Campaign[]
  sites       Site[]
  transactions Transaction[]
  approvals   Approval[]
  adminLogs   AdminLog[]
}

model Campaign {
  id          Int       @id @default(autoincrement())
  advertiser  User      @relation(fields: [advertiserId], references: [id])
  advertiserId Int
  name        String
  budget      Float
  status      CampaignStatus @default(PENDING)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  creatives   Creative[]
  placements  Placement[]
  reports     Report[]
  impressions Impression[]
  conversions Conversion[]
}

model Creative {
  id         Int      @id @default(autoincrement())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId Int
  fileUrl    String
  clickUrl   String
  altText    String?
  createdAt  DateTime @default(now())
  impressions Impression[]
}

model Site {
  id          Int       @id @default(autoincrement())
  publisher   User      @relation(fields: [publisherId], references: [id])
  publisherId Int
  domain      String
  verified    Boolean   @default(false)
  approved    Boolean   @default(false)
  placements  Placement[]
  impressions Impression[]
}

model Placement {
  id         Int      @id @default(autoincrement())
  site       Site     @relation(fields: [siteId], references: [id])
  siteId     Int
  size       String
  pricing    PricingType
  price      Float
  approved   Boolean   @default(false)
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId Int?
  impressions Impression[]
}

model Transaction {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  amount     Float
  type       TransactionType
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model Approval {
  id          Int      @id @default(autoincrement())
  entityType  String   // 'campaign', 'site', 'creative', 'placement'
  entityId    Int
  status      ApprovalStatus
  reason      String?  // Required for rejections
  adminUser   User     @relation(fields: [adminUserId], references: [id])
  adminUserId Int
  createdAt   DateTime @default(now())
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  action     String   // 'approve', 'reject', 'create', 'update', 'delete'
  entityType String   // 'campaign', 'site', 'creative', 'placement', 'user'
  entityId   Int?
  createdAt  DateTime @default(now())
}

model Impression {
  id         Int      @id @default(autoincrement())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId Int
  creative   Creative @relation(fields: [creativeId], references: [id])
  creativeId Int
  placement  Placement? @relation(fields: [placementId], references: [id])
  placementId Int?
  site       Site? @relation(fields: [siteId], references: [id])
  siteId     Int?
  device     String?
  country    String?
  browser    String?
  os         String?
  costMicros Int      @default(0)
  createdAt  DateTime @default(now())
  clicks     Click[]
}

model Click {
  id           Int         @id @default(autoincrement())
  impression   Impression  @relation(fields: [impressionId], references: [id])
  impressionId Int
  createdAt    DateTime    @default(now())
  conversions  Conversion[]
}

model Conversion {
  id         Int      @id @default(autoincrement())
  click      Click?   @relation(fields: [clickId], references: [id])
  clickId    Int?
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId Int
  value      Float    @default(0)
  currency   String   @default("USD")
  createdAt  DateTime @default(now())
}

model Report {
  id         Int      @id @default(autoincrement())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId Int
  date       DateTime
  impressions Int
  clicks     Int
  spend      Float
}

enum Role {
  ADVERTISER
  PUBLISHER
  ADMIN
}

enum CampaignStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum PricingType {
  CPM
  CPA
  CPI
  FIXED
}

enum TransactionType {
  DEPOSIT
  PAYOUT
}

enum ApprovalStatus {
  APPROVED
  REJECTED
}