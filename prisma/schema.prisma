generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  role         Role
  name         String?
  createdAt    DateTime      @default(now())
  password     String?
  emailVerified DateTime?
  adminLogs    AdminLog[]
  approvals    Approval[]
  campaigns    Campaign[]
  sites        Site[]
  transactions Transaction[]
  verificationTokens VerificationToken[]
  orders       Order[]
}

model Campaign {
  id           Int            @id @default(autoincrement())
  advertiserId Int
  name         String
  budget       Float
  status       CampaignStatus @default(PENDING)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime       @default(now())
  advertiser   User           @relation(fields: [advertiserId], references: [id])
  conversions  Conversion[]
  creatives    Creative[]
  impressions  Impression[]
  placements   Placement[]
  reports      Report[]
  orders       Order[]
}

model Creative {
  id          Int          @id @default(autoincrement())
  campaignId  Int
  fileUrl     String
  clickUrl    String
  altText     String?
  createdAt   DateTime     @default(now())
  campaign    Campaign     @relation(fields: [campaignId], references: [id])
  impressions Impression[]
}

model Site {
  id          Int          @id @default(autoincrement())
  publisherId Int
  domain      String
  verified    Boolean      @default(false)
  approved    Boolean      @default(false)
  impressions Impression[]
  placements  Placement[]
  publisher   User         @relation(fields: [publisherId], references: [id])
}

model Placement {
  id          Int          @id @default(autoincrement())
  siteId      Int
  size        String
  pricing     PricingType
  price       Float
  approved    Boolean      @default(false)
  campaignId  Int?
  impressions Impression[]
  campaign    Campaign?    @relation(fields: [campaignId], references: [id])
  site        Site         @relation(fields: [siteId], references: [id])
}

model Transaction {
  id        Int             @id @default(autoincrement())
  userId    Int
  amount    Float
  type      TransactionType
  status    String          @default("PENDING")
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id])
}

model Approval {
  id          Int            @id @default(autoincrement())
  entityType  String
  entityId    Int
  status      ApprovalStatus
  reason      String?
  adminUserId Int
  createdAt   DateTime       @default(now())
  adminUser   User           @relation(fields: [adminUserId], references: [id])
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  entityType String
  entityId   Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Impression {
  id          Int        @id @default(autoincrement())
  campaignId  Int
  creativeId  Int
  placementId Int?
  siteId      Int?
  device      String?
  country     String?
  browser     String?
  os          String?
  costMicros  Int        @default(0)
  createdAt   DateTime   @default(now())
  clicks      Click[]
  campaign    Campaign   @relation(fields: [campaignId], references: [id])
  creative    Creative   @relation(fields: [creativeId], references: [id])
  placement   Placement? @relation(fields: [placementId], references: [id])
  site        Site?      @relation(fields: [siteId], references: [id])
}

model Click {
  id           Int          @id @default(autoincrement())
  impressionId Int
  createdAt    DateTime     @default(now())
  impression   Impression   @relation(fields: [impressionId], references: [id])
  conversions  Conversion[]
}

model Conversion {
  id         Int      @id @default(autoincrement())
  clickId    Int?
  campaignId Int
  value      Float    @default(0)
  currency   String   @default("USD")
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  click      Click?   @relation(fields: [clickId], references: [id])
}

model Report {
  id          Int      @id @default(autoincrement())
  campaignId  Int
  date        DateTime
  impressions Int
  clicks      Int
  spend       Float
  campaign    Campaign @relation(fields: [campaignId], references: [id])
}

enum Role {
  ADVERTISER
  PUBLISHER
  ADMIN
}

enum CampaignStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum PricingType {
  CPM
  CPA
  CPI
  FIXED
}

enum TransactionType {
  DEPOSIT
  PAYOUT
}

enum ApprovalStatus {
  APPROVED
  REJECTED
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expires   DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model Order {
  id                String      @id @default(cuid())
  advertiserId      Int
  advertiser        User        @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaignId        Int?        // Optional link to an existing campaign
  campaign          Campaign?   @relation(fields: [campaignId], references: [id])
  title             String
  notes             String?     @db.Text
  totalAmountMicros BigInt      @default(0) // store as micros to avoid float
  currency          String      @default("USD")
  status            OrderStatus @default(PENDING)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([advertiserId, status])
  @@index([status, createdAt])
}
