    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "globby": "^14.1.0",
    "pino": "^8.16.2",
    "postcss": "^8",
    "prettier": "^3.1.1",
    "prisma": "^6.16.2",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5"
