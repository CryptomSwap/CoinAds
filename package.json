{
  "name": "coinads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/enforce-prod.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --name init",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "NODE_ENV=production tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "audit:metadata": "tsx scripts/audit-metadata.ts",
    "analyze": "tsx scripts/analyze-platform.ts",
    "runtime": "tsx scripts/check-runtime.ts",
    "audit": "npm run analyze && npm run runtime && playwright test tests/auth-google.spec.ts --reporter=list && tsx scripts/write-audit.ts",
    "audit:routes": "tsx scripts/route-inventory.ts",
    "audit:db": "playwright test tests/db.api.spec.ts",
    "audit:ui": "playwright test tests/ui.screens-and-buttons.spec.ts",
    "audit:report": "tsx scripts/generate-db-and-ui-report.ts",
    "audit:all": "npm run audit:routes && npm run audit:db && npm run audit:ui && npm run audit:report",
    "ci:nomocks": "tsx scripts/check-no-mocks.ts"
  },
  "dependencies": {
